#!/usr/bin/env bash
# gdrive-mount: monta Google Drive in una cartella con rclone e systemd --user.
# Pensato per Fedora 44+, dove gvfs non include più il backend Google Drive.
# Il montaggio segue l'account Google di Impostazioni → Account online: c'è solo se c'è l'account.
set -euo pipefail

VERSION="0.2.0"
REMOTE="${GDRIVE_REMOTE:-gdrive}"
MOUNT_DIR="${GDRIVE_DIR:-$HOME/GoogleDrive}"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
UNIT_DIR="$CONFIG_HOME/systemd/user"
UNIT_NAME="gdrive-mount.service"
UNIT_FILE="$UNIT_DIR/$UNIT_NAME"
WATCH_NAME="gdrive-mount-goa.path"
WATCH_FILE="$UNIT_DIR/$WATCH_NAME"
SYNC_NAME="gdrive-mount-goa.service"
SYNC_FILE="$UNIT_DIR/$SYNC_NAME"
GOA_DIR="$CONFIG_HOME/goa-1.0"
GOA_CONF="$GOA_DIR/accounts.conf"
# Versioni precedenti aggiungevano un segnalibro; ora il montaggio compare già come volume
BOOKMARKS="$CONFIG_HOME/gtk-3.0/bookmarks"
BOOKMARK_LINE="file://$MOUNT_DIR Google Drive"
RCLONE_CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/rclone"

msg() { printf '%s\n' "$*"; }
die() { printf 'Errore: %s\n' "$*" >&2; exit 1; }

ask() {
    # ask "domanda" -> 0 se l'utente risponde sì; con ASSUME_YES=1 risponde sì da solo
    [[ "${ASSUME_YES:-0}" == 1 ]] && return 0
    local reply
    read -r -p "$1 [s/N] " reply || return 1
    [[ "$reply" =~ ^[sSyY] ]]
}

need_rclone() {
    command -v rclone >/dev/null 2>&1 && return 0
    die "rclone non è installato. Installalo con: sudo dnf install rclone"
}

remote_exists() {
    rclone listremotes 2>/dev/null | grep -qx "$REMOTE:"
}

goa_google_accounts() {
    # Elenca le identità (email) degli account Google configurati in Account online
    [[ -f "$GOA_CONF" ]] || return 0
    awk -F= '
        /^\[/ { if (p == "google" && id != "") print id; p = ""; id = "" }
        $1 == "Provider" { p = $2 }
        $1 == "Identity" { id = substr($0, index($0, "=") + 1) }
        END { if (p == "google" && id != "") print id }
    ' "$GOA_CONF"
}

linked_account() {
    # L'account a cui è legato il montaggio: GDRIVE_ACCOUNT, altrimenti il primo account Google
    if [[ -n "${GDRIVE_ACCOUNT:-}" ]]; then
        printf '%s\n' "$GDRIVE_ACCOUNT"
    else
        goa_google_accounts | head -n1
    fi
}

has_account() {
    local account
    account="$(linked_account)"
    [[ -n "$account" ]] && goa_google_accounts | grep -qxF "$account"
}

write_units() {
    local self rclone_bin account
    self="$(readlink -f "$0")"
    rclone_bin="$(command -v rclone)"
    account="$(linked_account)"
    mkdir -p "$UNIT_DIR"

    cat > "$UNIT_FILE" <<EOF
[Unit]
Description=Google Drive di $account montato in $MOUNT_DIR (rclone)
Wants=network-online.target
After=network-online.target

[Service]
Type=notify
Environment="GDRIVE_ACCOUNT=$account" "GDRIVE_REMOTE=$REMOTE" "GDRIVE_DIR=$MOUNT_DIR"
ExecCondition=$self has-account
ExecStartPre=/usr/bin/mkdir -p $MOUNT_DIR
ExecStart=$rclone_bin mount $REMOTE: $MOUNT_DIR --vfs-cache-mode full --vfs-cache-max-size 5G --vfs-cache-max-age 24h --dir-cache-time 5m --poll-interval 1m
ExecStop=/usr/bin/fusermount3 -uz $MOUNT_DIR
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
EOF

    cat > "$WATCH_FILE" <<EOF
[Unit]
Description=Segue gli account di Account online per il montaggio di Google Drive

[Path]
PathChanged=$GOA_DIR
Unit=$SYNC_NAME

[Install]
WantedBy=default.target
EOF

    cat > "$SYNC_FILE" <<EOF
[Unit]
Description=Allinea il montaggio di Google Drive all'account di Account online

[Service]
Type=oneshot
Environment="GDRIVE_ACCOUNT=$account" "GDRIVE_REMOTE=$REMOTE" "GDRIVE_DIR=$MOUNT_DIR"
ExecStart=$self sync
EOF
}

remove_bookmark() {
    [[ -f "$BOOKMARKS" ]] || return 0
    grep -qxF "$BOOKMARK_LINE" "$BOOKMARKS" || return 0
    local tmp
    tmp="$(mktemp)"
    grep -vxF "$BOOKMARK_LINE" "$BOOKMARKS" > "$tmp" || true
    cat "$tmp" > "$BOOKMARKS"
    rm -f "$tmp"
}

unmount_dir() {
    if mountpoint -q "$MOUNT_DIR" 2>/dev/null; then
        fusermount3 -uz "$MOUNT_DIR" || true
    fi
}

clean_local() {
    # Cache VFS di rclone per questo remote e cartella di montaggio (solo se vuota:
    # non cancello mai file dell'utente)
    rm -rf "$RCLONE_CACHE/vfs/$REMOTE" "$RCLONE_CACHE/vfsMeta/$REMOTE"
    rmdir "$RCLONE_CACHE/vfs" "$RCLONE_CACHE/vfsMeta" "$RCLONE_CACHE" 2>/dev/null || true
    if [[ -d "$MOUNT_DIR" ]]; then
        rmdir "$MOUNT_DIR" 2>/dev/null || msg "Attenzione: $MOUNT_DIR non è vuota, la lascio dov'è."
    fi
}

cmd_setup() {
    need_rclone
    if remote_exists; then
        msg "Il remote '$REMOTE' esiste già."
    else
        msg "Si aprirà il browser per autorizzare rclone ad accedere a Google Drive."
        local opts=(scope=drive)
        # Il client_id condiviso di rclone viene ritirato: meglio usarne uno proprio
        if [[ -n "${GDRIVE_CLIENT_ID:-}" ]]; then
            opts+=("client_id=$GDRIVE_CLIENT_ID" "client_secret=${GDRIVE_CLIENT_SECRET:-}")
        else
            msg "Nota: senza GDRIVE_CLIENT_ID si usa il client_id condiviso di rclone, in via di ritiro (vedi README)."
        fi
        # rclone stampa la configurazione col token: non deve finire nel terminale
        rclone config create "$REMOTE" drive "${opts[@]}" >/dev/null
    fi
    rclone lsd "$REMOTE:" --max-depth 1 >/dev/null && msg "Connessione a Google Drive riuscita."
}

cmd_set_client() {
    need_rclone
    remote_exists || die "remote '$REMOTE' non configurato. Esegui prima: gdrive-mount setup"
    local id secret
    read -r -p "Client ID: " id
    # Il secret non viene mostrato né salvato nella cronologia della shell
    read -r -s -p "Client secret: " secret
    echo
    [[ -n "$id" && -n "$secret" ]] || die "client ID e secret sono entrambi obbligatori"
    msg "Si aprirà il browser: accedi di nuovo e autorizza la tua app."
    # update rifà anche l'autorizzazione OAuth col nuovo client; l'output contiene il token
    rclone config update "$REMOTE" client_id "$id" client_secret "$secret" >/dev/null
    if [[ -f "$UNIT_FILE" ]] && has_account; then
        systemctl --user restart "$UNIT_NAME"
    fi
    rclone lsd "$REMOTE:" --max-depth 1 >/dev/null && msg "Ora rclone usa il tuo client_id."
}

cmd_enable() {
    need_rclone
    remote_exists || die "remote '$REMOTE' non configurato. Esegui prima: gdrive-mount setup"
    has_account || die "nessun account Google${GDRIVE_ACCOUNT:+ $GDRIVE_ACCOUNT} in Impostazioni → Account online. Aggiungilo e riprova."
    local account
    account="$(linked_account)"
    mkdir -p "$MOUNT_DIR"
    write_units
    systemctl --user daemon-reload
    systemctl --user enable "$UNIT_NAME" "$WATCH_NAME"
    systemctl --user start "$WATCH_NAME"
    systemctl --user restart "$UNIT_NAME"
    remove_bookmark
    msg "Google Drive di $account è montato in $MOUNT_DIR (compare tra i volumi nella Gestione file)."
    msg "Se rimuovi l'account da Account online, il Drive viene smontato e la cache pulita."
}

cmd_sync() {
    # Lanciato da gdrive-mount-goa.path quando cambiano gli account di Account online
    if has_account; then
        systemctl --user start "$UNIT_NAME"
    else
        systemctl --user stop "$UNIT_NAME" || true
        unmount_dir
        clean_local
        msg "Account Google non presente in Account online: Google Drive smontato e cache pulita."
    fi
}

cmd_disable() {
    local u
    for u in "$WATCH_NAME" "$UNIT_NAME"; do
        [[ -f "$UNIT_DIR/$u" ]] && { systemctl --user disable --now "$u" || true; }
    done
    unmount_dir
    remove_bookmark
    msg "Montaggio automatico disattivato."
}

cmd_status() {
    local account
    account="$(linked_account)"
    msg "account:    ${account:-nessun account Google} ($(has_account && echo presente in Account online || echo assente))"
    msg "remote:     $REMOTE ($(command -v rclone >/dev/null && remote_exists && echo configurato || echo non configurato))"
    msg "cartella:   $MOUNT_DIR ($(mountpoint -q "$MOUNT_DIR" 2>/dev/null && echo montata || echo non montata))"
    if [[ -f "$UNIT_FILE" ]]; then
        msg "servizio:   $(systemctl --user is-enabled "$UNIT_NAME" 2>/dev/null || true), $(systemctl --user is-active "$UNIT_NAME" 2>/dev/null || true)"
        msg "controllo:  $(systemctl --user is-enabled "$WATCH_NAME" 2>/dev/null || true), $(systemctl --user is-active "$WATCH_NAME" 2>/dev/null || true)"
    else
        msg "servizio:   non installato"
    fi
}

cmd_uninstall() {
    cmd_disable
    local u removed=0
    for u in "$UNIT_FILE" "$WATCH_FILE" "$SYNC_FILE"; do
        [[ -f "$u" ]] && { rm -f "$u"; removed=1; }
    done
    if (( removed )); then
        systemctl --user daemon-reload
        systemctl --user reset-failed "$UNIT_NAME" "$WATCH_NAME" "$SYNC_NAME" 2>/dev/null || true
    fi

    clean_local

    if command -v rclone >/dev/null 2>&1 && remote_exists; then
        if ask "Rimuovere anche l'autorizzazione di rclone a Google Drive (remote '$REMOTE')?"; then
            rclone config delete "$REMOTE"
            local conf
            conf="$(rclone config file 2>/dev/null | tail -n1)"
            # Se il file di configurazione è rimasto vuoto, lo tolgo insieme alla sua cartella
            if [[ -f "$conf" && ! -s "$conf" ]]; then
                rm -f "$conf"
                rmdir "$(dirname "$conf")" 2>/dev/null || true
            fi
        fi
    fi

    local self
    self="$(readlink -f "$0")"
    if [[ "$self" == "$HOME/.local/bin/gdrive-mount" ]]; then
        rm -f "$self"
        msg "Rimosso $self."
    fi

    msg "Disinstallazione completata."
    if command -v rclone >/dev/null 2>&1; then
        msg "rclone è ancora installato. Se non ti serve più: sudo dnf remove rclone"
    fi
}

usage() {
    cat <<EOF
gdrive-mount $VERSION - Google Drive come cartella su Fedora (rclone + systemd)

Uso: gdrive-mount <comando>

Comandi:
  setup        collega rclone al tuo account Google (si apre il browser)
  set-client   passa a un client_id Google tuo (chiede ID e secret)
  enable       monta Google Drive in $MOUNT_DIR finché l'account Google
               è presente in Impostazioni → Account online
  disable      smonta e disattiva il montaggio automatico
  status       mostra lo stato
  uninstall    rimuove servizi, cache e (a scelta) l'autorizzazione

Variabili: GDRIVE_ACCOUNT (predefinito: il primo account Google di Account online),
           GDRIVE_REMOTE (predefinito: gdrive), GDRIVE_DIR (predefinito: ~/GoogleDrive)
EOF
}

case "${1:-}" in
    setup) cmd_setup ;;
    set-client) cmd_set_client ;;
    enable) cmd_enable ;;
    disable) cmd_disable ;;
    status) cmd_status ;;
    uninstall) cmd_uninstall ;;
    sync) cmd_sync ;;
    has-account) has_account ;;
    -h|--help|help|"") usage ;;
    --version) msg "$VERSION" ;;
    *) usage >&2; exit 2 ;;
esac
